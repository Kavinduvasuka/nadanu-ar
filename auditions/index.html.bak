  <div id="arContainer"></div>
  <div class="experience-top"><button id="exit" class="glass" aria-label="Exit the show">â† Back</button><span id="modeTag" class="mode-pill">POSTER AR</span><button id="sound" class="glass" aria-pressed="true">Music on</button></div>
  <div id="scanner"><p class="scan-eyebrow"><span></span> NADANU / POSTER RECOGNITION</p><div class="viewfinder"><div class="scan-grid" aria-hidden="true"></div><span class="corner-id corner-one" aria-hidden="true">01</span><span class="corner-id corner-two" aria-hidden="true">02</span><span class="scan-lock" aria-hidden="true">âœ“</span><i></i><i></i><i></i><i></i><div class="scan-line"></div></div><p class="scan-heading"><span class="search-label">FRAME YOUR POSTER</span><span class="lock-label">POSTER DETECTED</span></p><p id="status" role="status">Preparing your posterâ€¦</p><div class="scan-steps" aria-hidden="true"><span>CAMERA</span><i></i><span>POSTER</span><i></i><span>SHOWTIME</span></div><button id="fallback" class="glass" hidden>Watch the show instead</button></div>
